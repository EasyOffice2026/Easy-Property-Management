# Database
DATABASE_URL=postgresql://epm_user:epm_password@localhost:5432/epm_db

# JWT
JWT_SECRET=change-this-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_S3_BUCKET=epm-documents

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@epm.com

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Petty Cash
PETTY_CASH_MONTHLY_LIMIT=1000
CONTRACT_NUMBER_PREFIX=EPM
EXPIRY_WARNING_DAYS=30
OVERDUE_GRACE_DAYS=7
