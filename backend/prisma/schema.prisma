generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(LEASING_AGENT)
  language     Language   @default(EN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  journalEntries JournalEntry[] @relation("JournalCreatedBy")
  vouchers       Voucher[]      @relation("VoucherCreatedBy")
}

enum Role {
  SUPER_ADMIN
  PROPERTY_MANAGER
  LEASING_AGENT
  MAINTENANCE_SUPERVISOR
  ACCOUNTANT
  VIEWER
}

enum Language {
  EN
  AR
}

model Building {
  id          String   @id @default(uuid())
  nameEn      String
  nameAr      String
  address     String
  totalFloors Int
  facilities  String[]
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  units       Unit[]
  workOrders  WorkOrder[]
  assets      Asset[]
  pettyCash   PettyCashTransaction[]
}

model Unit {
  id         String     @id @default(uuid())
  buildingId String
  building   Building   @relation(fields: [buildingId], references: [id])
  unitNumber String
  floor      Int
  type       UnitType
  status     UnitStatus @default(AVAILABLE)
  rentAmount Decimal    @db.Decimal(10, 3)
  furnished  Boolean    @default(true)
  notes      String?
  contracts  Contract[]
  workOrders WorkOrder[]
}

enum UnitType {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  PENTHOUSE
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

model Tenant {
  id               String     @id @default(uuid())
  tenantType       TenantType
  firstName        String?
  lastName         String?
  companyName      String?
  nationality      String
  email            String
  phone            String?
  mobile           String
  civilId          String?
  passportNumber   String?
  emergencyContact String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  documents        Document[]
  contracts        Contract[]
  inquiries        Inquiry[]
}

enum TenantType {
  INDIVIDUAL
  COMPANY
}

model Document {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model Inquiry {
  id               String         @id @default(uuid())
  tenantType       TenantType
  firstName        String
  lastName         String?
  companyName      String?
  mobile           String
  email            String?
  channel          InquiryChannel
  unitTypeInterest UnitType?
  rentPeriod       RentPeriod?
  notes            String?
  status           InquiryStatus  @default(NEW)
  assignedToId     String?
  tenantId         String?
  tenant           Tenant?        @relation(fields: [tenantId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum InquiryChannel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  CALL_CENTER
  WALK_IN
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CONVERTED
  LOST
}

enum RentPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Contract {
  id              String         @id @default(uuid())
  contractNumber  String         @unique
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id])
  rentPeriod      RentPeriod
  rentAmount      Decimal        @db.Decimal(10, 3)
  securityDeposit Decimal        @default(0) @db.Decimal(10, 3)
  startDate       DateTime
  endDate         DateTime
  status          ContractStatus @default(DRAFT)
  signedAt        DateTime?
  clearedAt       DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  CLEARED
}

model WorkOrder {
  id            String     @id @default(uuid())
  woNumber      String     @unique
  unitId        String?
  unit          Unit?      @relation(fields: [unitId], references: [id])
  buildingId    String
  building      Building   @relation(fields: [buildingId], references: [id])
  trade         Trade
  priority      Priority   @default(ROUTINE)
  description   String
  status        WOStatus   @default(PENDING)
  assignedToId  String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  estimatedCost Decimal?   @db.Decimal(10, 3)
  actualCost    Decimal?   @db.Decimal(10, 3)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum Trade {
  ELECTRICAL
  PLUMBING
  CARPENTRY
  MASONRY
  CLEANING
  OTHER
}

enum Priority {
  EMERGENCY
  HIGH
  ROUTINE
}

enum WOStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Asset {
  id              String      @id @default(uuid())
  buildingId      String
  building        Building    @relation(fields: [buildingId], references: [id])
  name            String
  category        Trade
  location        String
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  nextServiceDate DateTime?
  status          AssetStatus @default(GOOD)
  notes           String?
}

enum AssetStatus {
  GOOD
  SERVICE_DUE
  OVERDUE
  OUT_OF_SERVICE
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
}

model PettyCashTransaction {
  id          String                  @id @default(uuid())
  buildingId  String?
  building    Building?               @relation(fields: [buildingId], references: [id])
  type        PettyCashTransactionType
  category    PettyCashCategory
  amount      Decimal                 @db.Decimal(10, 3)
  description String
  receiptUrl  String?
  requestedBy String
  approvedBy  String?
  status      PettyCashStatus         @default(PENDING)
  occurredAt  DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

enum PettyCashTransactionType {
  REPLENISHMENT
  EXPENSE
}

enum PettyCashCategory {
  MAINTENANCE
  SUPPLIES
  UTILITIES
  TRANSPORT
  OFFICE
  OTHER
}

enum PettyCashStatus {
  PENDING
  APPROVED
  REJECTED
}

// ========================
// ACCOUNTING MODULE
// ========================

model Account {
  id            String      @id @default(uuid())
  code          String      @unique
  nameEn        String
  nameAr        String
  type          AccountType
  parentId      String?
  parent        Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]   @relation("AccountTree")
  isActive      Boolean     @default(true)
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  journalLines  JournalEntryLine[]
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique
  date        DateTime
  description String
  reference   String?
  status      JournalStatus      @default(DRAFT)
  totalAmount Decimal            @db.Decimal(10, 3)
  createdById String
  createdBy   User               @relation("JournalCreatedBy", fields: [createdById], references: [id])
  voucherId   String?
  voucher     Voucher?           @relation("VoucherJournal")
  lines       JournalEntryLine[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(10, 3)
  credit         Decimal      @default(0) @db.Decimal(10, 3)
  description    String?
}

model Voucher {
  id            String        @id @default(uuid())
  voucherNumber String        @unique
  type          VoucherType
  date          DateTime
  partyName     String
  description   String
  amount        Decimal       @db.Decimal(10, 3)
  paymentMethod String?
  referenceNo   String?
  status        VoucherStatus @default(DRAFT)
  createdById   String
  createdBy     User          @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  journalEntry  JournalEntry? @relation("VoucherJournal", fields: [journalEntryId], references: [id])
  journalEntryId String?     @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum VoucherType {
  RECEIPT
  PAYMENT
}

enum VoucherStatus {
  DRAFT
  APPROVED
  VOID
}

model BankTransaction {
  id            String              @id @default(uuid())
  date          DateTime
  description   String
  reference     String?
  debit         Decimal             @default(0) @db.Decimal(10, 3)
  credit        Decimal             @default(0) @db.Decimal(10, 3)
  balance       Decimal             @db.Decimal(10, 3)
  status        ReconciliationStatus @default(UNMATCHED)
  matchedVoucherId String?
  importBatch   String?
  createdAt     DateTime            @default(now())
}

enum ReconciliationStatus {
  MATCHED
  UNMATCHED
  EXCLUDED
}
