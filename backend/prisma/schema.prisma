generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(LEASING_AGENT)
  language     Language   @default(EN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

enum Role {
  SUPER_ADMIN
  PROPERTY_MANAGER
  LEASING_AGENT
  MAINTENANCE_SUPERVISOR
  ACCOUNTANT
  VIEWER
}

enum Language {
  EN
  AR
}

model Building {
  id          String   @id @default(uuid())
  nameEn      String
  nameAr      String
  address     String
  totalFloors Int
  facilities  String[]
  managerId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  units       Unit[]
}

model Unit {
  id         String     @id @default(uuid())
  buildingId String
  building   Building   @relation(fields: [buildingId], references: [id])
  unitNumber String
  floor      Int
  type       UnitType
  status     UnitStatus @default(AVAILABLE)
  rentAmount Decimal    @db.Decimal(10, 3)
  furnished  Boolean    @default(true)
  notes      String?
  contracts  Contract[]
}

enum UnitType {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  PENTHOUSE
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

model Tenant {
  id               String     @id @default(uuid())
  tenantType       TenantType
  firstName        String?
  lastName         String?
  companyName      String?
  nationality      String
  email            String
  phone            String?
  mobile           String
  civilId          String?
  passportNumber   String?
  emergencyContact String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  documents        Document[]
  contracts        Contract[]
  inquiries        Inquiry[]
}

enum TenantType {
  INDIVIDUAL
  COMPANY
}

model Document {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model Inquiry {
  id               String         @id @default(uuid())
  tenantType       TenantType
  firstName        String
  lastName         String?
  companyName      String?
  mobile           String
  email            String?
  channel          InquiryChannel
  unitTypeInterest UnitType?
  rentPeriod       RentPeriod?
  notes            String?
  status           InquiryStatus  @default(NEW)
  assignedToId     String?
  tenantId         String?
  tenant           Tenant?        @relation(fields: [tenantId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum InquiryChannel {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  CALL_CENTER
  WALK_IN
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CONVERTED
  LOST
}

enum RentPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Contract {
  id              String         @id @default(uuid())
  contractNumber  String         @unique
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  unitId          String
  unit            Unit           @relation(fields: [unitId], references: [id])
  rentPeriod      RentPeriod
  rentAmount      Decimal        @db.Decimal(10, 3)
  securityDeposit Decimal        @default(0) @db.Decimal(10, 3)
  startDate       DateTime
  endDate         DateTime
  status          ContractStatus @default(DRAFT)
  signedAt        DateTime?
  clearedAt       DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  CLEARED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())
}
